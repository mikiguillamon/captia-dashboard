<% content_for :title, "Aceptar invitación" %>

<main class="min-h-screen flex items-center justify-center bg-white px-4">
  <section class="w-full max-w-sm bg-slate-100 rounded-lg p-6 space-y-4" aria-labelledby="invite-heading">
    <h1 id="invite-heading" class="text-xl font-semibold text-slate-900 leading-tight">
      Únete a <%= @invitation.organization.name %>
    </h1>
    <p class="text-sm text-slate-600">
      Crea tu acceso con el correo <strong><%= @invitation.email %></strong> y el rol
      <strong><%= @invitation.role %></strong>.
    </p>

    <% if flash[:alert] %>
      <p role="alert" aria-live="polite" class="text-sm text-red-600 bg-white border border-red-200 rounded-md px-4 py-2">
        <%= flash[:alert] %>
      </p>
    <% end %>

    <%= form_with url: accept_invitations_path, method: :post, local: true, class: "space-y-4" do |form| %>
      <%= hidden_field_tag :token, @token %>

      <div class="space-y-2">
        <%= form.label :email_address, "Correo electrónico", class: "block text-sm font-medium text-slate-700" %>
        <%= form.email_field :email_address, value: @invitation.email, required: true,
              autocomplete: "username",
              class: "w-full rounded-md border-slate-300 bg-white px-3 py-2 focus:ring-2 focus:ring-blue-600 focus:outline-none" %>
      </div>

      <div class="space-y-2">
        <%= form.label :password, "Contraseña (mínimo 12 caracteres)", class: "block text-sm font-medium text-slate-700" %>
        <%= form.password_field :password, required: true, minlength: 12,
              autocomplete: "new-password",
              class: "w-full rounded-md border-slate-300 bg-white px-3 py-2 focus:ring-2 focus:ring-blue-600 focus:outline-none" %>
      </div>

      <%= form.submit "Crear mi acceso",
            data: { turbo_submits_with: "Creando…" },
            class: "w-full rounded-md bg-blue-600 text-white font-medium py-2 px-4 hover:bg-blue-700 disabled:opacity-50 cursor-pointer" %>
    <% end %>
  </section>
</main>
