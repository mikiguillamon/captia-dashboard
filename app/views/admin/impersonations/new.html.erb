<% content_for :title, "Impersonar usuario" %>

<main class="min-h-screen bg-white">
  <div class="max-w-md mx-auto px-4 py-8 space-y-4">
    <h1 class="text-xl font-semibold text-slate-900">Impersonar usuario</h1>
    <p class="text-sm text-slate-600">
      La sesión dura máximo 30 minutos y <strong>todas las acciones quedan registradas</strong>
      con tu identidad como responsable. Requiere tu contraseña para autorizar el acceso.
    </p>

    <% if flash[:alert] %>
      <p role="alert" aria-live="polite" class="text-sm text-red-600 bg-red-50 border border-red-200 rounded-md px-4 py-2">
        <%= flash[:alert] %>
      </p>
    <% end %>

    <%= form_with url: impersonation_path, method: :post, local: true, class: "space-y-4" do |form| %>
      <div class="space-y-2">
        <%= form.label :target_user_id, "Usuario a impersonar", class: "block text-sm font-medium text-slate-700" %>
        <%= form.collection_select :target_user_id,
              User.where.not(id: Current.user.id).order(:email_address),
              :id, :email_address,
              {}, class: "w-full rounded-md border-slate-300 bg-white px-3 py-2 focus:ring-2 focus:ring-blue-600 focus:outline-none" %>
      </div>

      <div class="space-y-2">
        <%= form.label :password, "Tu contraseña", class: "block text-sm font-medium text-slate-700" %>
        <%= form.password_field :password, required: true, autocomplete: "current-password",
              class: "w-full rounded-md border-slate-300 bg-white px-3 py-2 focus:ring-2 focus:ring-blue-600 focus:outline-none" %>
      </div>

      <%= form.submit "Iniciar impersonación",
            data: { turbo_submits_with: "Iniciando…" },
            class: "rounded-md bg-blue-600 text-white text-sm font-medium py-2 px-4 hover:bg-blue-700 disabled:opacity-50 cursor-pointer" %>
    <% end %>
  </div>
</main>
