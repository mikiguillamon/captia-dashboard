<li id="<%= dom_id(lead) %>" class="bg-slate-100 rounded-md px-4 py-3 flex items-center justify-between gap-3">
  <div class="min-w-0">
    <div class="font-medium text-slate-900 truncate"><%= lead.name %></div>
    <div class="text-sm text-slate-600 truncate"><%= lead.email %></div>
    <% if lead.company.present? %>
      <div class="text-xs text-slate-500 truncate"><%= lead.company %></div>
    <% end %>
  </div>
  <div class="flex items-center gap-2 shrink-0">
    <span class="text-xs font-medium px-2 py-0.5 rounded-full bg-slate-200 text-slate-700"><%= lead.status %></span>
    <% if lead.status != "converted" %>
      <%= button_to "Convertir", convert_crm_lead_path(lead), method: :post,
            data: { turbo_confirm: "¿Convertir este lead en cuenta y contacto?" },
            class: "text-xs font-medium text-blue-600 hover:underline bg-transparent border-0 p-0 cursor-pointer" %>
    <% end %>
    <%= link_to "Editar", edit_crm_lead_path(lead),
          data: { turbo_frame: "lead_form_#{lead.id}" },
          class: "text-xs font-medium text-slate-600 hover:underline" %>
    <%= button_to "Eliminar", crm_lead_path(lead), method: :delete,
          data: { turbo_confirm: "¿Eliminar este lead?" },
          class: "text-xs font-medium text-red-600 hover:underline bg-transparent border-0 p-0 cursor-pointer" %>
  </div>
</li>