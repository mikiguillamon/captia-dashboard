<li id="<%= dom_id(contact) %>" class="bg-slate-100 rounded-md px-4 py-3 flex items-center justify-between gap-3">
  <div class="min-w-0">
    <div class="font-medium text-slate-900 truncate"><%= contact.full_name %></div>
    <div class="text-sm text-slate-600 truncate"><%= contact.email %></div>
    <% if contact.role.present? %>
      <div class="text-xs text-slate-500 truncate"><%= contact.role %></div>
    <% end %>
  </div>
  <div class="flex items-center gap-2 shrink-0">
    <%= link_to "Editar", edit_crm_contact_path(contact),
          data: { turbo_frame: "contact_form_#{contact.id}" },
          class: "text-xs font-medium text-slate-600 hover:underline" %>
    <%= button_to "Eliminar", crm_contact_path(contact), method: :delete,
          data: { turbo_confirm: "¿Eliminar este contacto?" },
          class: "text-xs font-medium text-red-600 hover:underline bg-transparent border-0 p-0 cursor-pointer" %>
  </div>
</li>