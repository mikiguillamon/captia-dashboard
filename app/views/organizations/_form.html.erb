<%= form_with model: organization, url: organizations_path, class: "flex flex-col sm:flex-row gap-2 sm:items-end" do |form| %>
  <div class="flex-1 space-y-1">
    <%= form.label :name, "Nombre", class: "block text-sm font-medium text-slate-700" %>
    <%= form.text_field :name,
          required: true,
          placeholder: "p. ej. Acme Corp",
          class: "w-full rounded-md border-slate-300 bg-white px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-600 focus:border-blue-600" %>
    <% if organization.errors[:name].any? %>
      <p role="alert" aria-live="polite" class="text-sm text-red-600">
        <%= organization.errors.full_messages_for(:name).to_sentence %>
      </p>
    <% end %>
  </div>
  <%= form.submit "Crear organización",
        data: { turbo_submits_with: "Creando…" },
        class: "rounded-md bg-blue-600 text-white text-sm font-medium py-2 px-4 hover:bg-blue-700 disabled:opacity-50 cursor-pointer focus:outline-none focus:ring-2 focus:ring-blue-600 focus:ring-offset-2" %>
<% end %>
